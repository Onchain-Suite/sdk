{
  "name": "@onchainsuite/sdk",
  "version": "0.4.0",
  "description": "In-app, web push and mobile push notifications for any dApp — wallet-authenticated, real-time, and lightweight.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/inapp.js",
  "jsdelivr": "./dist/inapp.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inapp.js": "./dist/inapp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onchain-Suite/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Onchain-Suite/sdk/issues"
  },
  "homepage": "https://github.com/Onchain-Suite/sdk#readme",
  "files": [
    "dist",
    "src",
    "public",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:esm && npm run build:iife",
    "build:esm": "tsc -p tsconfig.json",
    "build:iife": "esbuild src/browser.ts --bundle --format=iife --platform=browser --target=es2020 --minify --legal-comments=none --outfile=dist/inapp.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "onchainsuite",
    "web3",
    "in-app",
    "push",
    "notifications",
    "wallet",
    "sdk"
  ],
  "license": "MIT",
  "dependencies": {
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
